# SellerOS Marketplace Platform — PATCH 3/10
# Desenvolvimento pode usar SQLite local. Produção deve usar PostgreSQL.

ENV=development
ENABLE_DEMO_USER=true
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Dev local padrão se vazio: sqlite:///./data/marketplace_seller_platform.sqlite
# Produção Render/Railway: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Mercado Livre OAuth REAL
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/auth/ml/callback
FERNET_KEY=
FRONTEND_URL=http://localhost:5173

TAX_RATE=0.06
ML_MIN_MARGIN=0.10
ML_RETRAIN_DAYS=7
SCRAPING_DELAY_MIN=1.0
SCRAPING_DELAY_MAX=3.0
SCRAPING_MAX_PAGES=5
SCRAPING_TIMEOUT=15
LOG_LEVEL=INFO
USE_AIRFLOW=false
AIRFLOW_HOME=./data_engineering

VITE_API_URL=http://localhost:8000
VITE_ENABLE_DEMO_LOGIN=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Questions Assistant (opcional; fallback seguro quando vazio)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant


# PATCH 9/10 — Alertas operacionais (opcionais)
TELEGRAM_BOT_TOKEN=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ALERT_DEDUPE_WINDOW_MINUTES=120

PAGARME_API_KEY=
PAGARME_BASE_URL=https://api.pagar.me/core/v5
PAGARME_WEBHOOK_SECRET=
BILLING_TRIAL_DAYS=7

# E-mail transacional (Resend — gratuito até 3.000/mês)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@seudominio.com
RESEND_FROM_NAME=SellerOS

# Privacidade e retenção (LGPD)
PRIVACY_CONTACT_EMAIL=
API_LOG_RETENTION_DAYS=90
SCRAPING_LOG_RETENTION_DAYS=90
PRIVACY_REQUEST_RETENTION_DAYS=1825
