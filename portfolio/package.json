{
  "name": "marketplace-seller-platform-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/marketplace-seller-platform/",
    "check": "tsc --noEmit",
    "test": "node tests/demo-data.test.mjs && node tests/privacy.test.mjs && node tests/access.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
